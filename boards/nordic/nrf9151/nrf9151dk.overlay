/*
 * Reuse the nRF9151 DK board nodes instead of creating duplicate devices.
 * The right-hand labels come from nrf9151dk_nrf9151_common.dtsi.
 * These mappings already match the board defaults; they are explicit here
 * so the application aliases can be changed without redefining pin wiring.
 * gpio_interrupt.cpp currently uses raw pin constants; these aliases are an
 * optional alternative shown in comments there, not its active pin source.
 */

/ {
	aliases {
		flickled0 = &led0;       /* Board LED 1: P0.00 */
		flickled1 = &led1;       /* Board LED 2: P0.01 */
		flickled2 = &led2;       /* Board LED 3: P0.04 */
		flickled3 = &led3;       /* Board LED 4: P0.05 */
		sw0 = &button0;    /* Board button 1: P0.08 */
	};
};


&uart0 {
status = "disabled";
};
&uart1 {

status = "okay";
};

  &i2c0{
	status = "disabled";
  };

&spi0{

	status = "disabled";
};


