/*
 * nRF9151 DK - custom LED/button overlay
 *
 * gpio0 and gpiote (instance 1, Non-Secure @ 0x40031000) are already
 * `status = "okay"` by default in nrf9151dk_nrf9151_common.dtsi - do
 * NOT redeclare their reg/interrupts here; the earlier draft's attempt
 * to do so used a transposed GPIO address, the Secure (not Non-Secure)
 * GPIOTE address, and the wrong IRQ number. Nothing needs touching
 * there - this overlay only adds the pin definitions.
 *
 * Pin facts below are from the nRF9151 DK Hardware User Guide, section
 * 4.8 "Buttons and LEDs":
 *   LED1    = P0.00, active-HIGH (driven through a power transistor)
 *   Button1 = P0.08, active-LOW, no external pull-up
 */

/ {
	aliases {
		led0 = &custom_led0;
		sw0  = &custom_button0;
	};

	custom_leds {
		compatible = "gpio-leds";
		custom_led0: led_0 {
			gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
			label = "Onboard LED 1";
		};
	};

	custom_buttons {
		compatible = "gpio-keys";
		custom_button0: button_0 {
			gpios = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Onboard Button 1";
		};
	};
};