/* Driver-owned external target: A5=SCL/P0.02, A4=SDA/P0.31.
 * TWIS pin functions differ from the board's default TWIM pin functions. */
&pinctrl {
    imu_target_default: imu_target_default {
        group1 {
            psels = <NRF_PSEL(TWIS_SCL, 0, 2)>, <NRF_PSEL(TWIS_SDA, 0, 31)>;
            bias-pull-up;
        };
    };
    imu_target_sleep: imu_target_sleep {
        group1 {
            psels = <NRF_PSEL(TWIS_SCL, 0, 2)>, <NRF_PSEL(TWIS_SDA, 0, 31)>;
            low-power-enable;
        };
    };
};
&i2c0 {
    compatible = "nordic,nrf-twis";
    status = "okay";
    pinctrl-0 = <&imu_target_default>;
    pinctrl-1 = <&imu_target_sleep>;
    pinctrl-names = "default", "sleep";
};
/* Instance 1 remains the internal sensor controller. Never make it a target. */
&i2c1 { status = "okay"; };
&spi0 { status = "disabled"; };
&spi1 { status = "disabled"; };
/* SPI2 otherwise owns the yellow LED's P0.13 pin. */
&spi2 { status = "disabled"; };
&pwm0 { status = "okay"; };
&pwm1 { status = "disabled"; };
&pwm2 { status = "disabled"; };
/* Onboard RGB channels are active low; driver handles polarity and EasyDMA. */
&red_pwm_led { pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_INVERTED>; };
&green_pwm_led { pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_INVERTED>; };
&blue_pwm_led { pwms = <&pwm0 2 PWM_MSEC(1) PWM_POLARITY_INVERTED>; };
&lps22hb { status = "disabled"; };
&apds9960 { status = "disabled"; };
